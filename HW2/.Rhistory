# Print R version and library paths
R.version.string
.libPaths()

# Check if marray and limma are available
installed.packages()[c("marray", "limma"), "Version"]

# If they show <NA> or "package not found", install them:
if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

BiocManager::install(c("marray", "limma"), ask = FALSE)
q()
